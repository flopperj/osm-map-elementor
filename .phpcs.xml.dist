<?xml version="1.0"?>
<ruleset name="OSM Map Widget for Elementor">
	<description>Coding standards and PHP compatibility for the plugin source.</description>

	<file>osm-map-elementor.php</file>
	<file>osm-map.php</file>
	<file>constants.php</file>

	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="osm-map-elementor"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>

		<!-- Layout-only sniffs: the legacy source uses 4-space indentation and short arrays throughout, and reformatting every line is out of scope. -->
		<exclude name="Generic.Classes.OpeningBraceSameLine"/>
		<exclude name="Generic.ControlStructures.InlineControlStructure"/>
		<exclude name="Generic.Formatting"/>
		<exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie"/>
		<exclude name="Generic.WhiteSpace"/>
		<exclude name="NormalizedArrays.Arrays"/>
		<exclude name="PEAR.Files.IncludingFile"/>
		<exclude name="PEAR.Functions.FunctionCallSignature"/>
		<exclude name="PSR2.ControlStructures.SwitchDeclaration"/>
		<exclude name="Squiz.ControlStructures.ControlSignature"/>
		<exclude name="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
		<exclude name="Squiz.PHP.EmbeddedPhp"/>
		<exclude name="Squiz.Strings.DoubleQuoteUsage"/>
		<exclude name="Squiz.WhiteSpace"/>
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<exclude name="Universal.WhiteSpace"/>
		<exclude name="WordPress.Arrays.ArrayDeclarationSpacing"/>
		<exclude name="WordPress.Arrays.ArrayKeySpacingRestrictions"/>
		<exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
		<exclude name="WordPress.WhiteSpace"/>
	</rule>
</ruleset>
